# 编排层
ORCH_HOST=0.0.0.0
ORCH_PORT=8000

# LLM Service
LLM_HOST=0.0.0.0
LLM_PORT=8001
ORCH_LLM_SERVICE_TIMEOUT_SECONDS=120
ORCH_LLM_SERVICE_TIMEOUT_RESPONSES_SECONDS=300
ORCH_LLM_SERVICE_RETRIES=2

# 模型
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0.3

# 预算
MAX_TOKEN=8000
MAX_COST_USD=5.0

# 存储
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/shannon
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=task_memories
QDRANT_VECTOR_SIZE=1536

# 数据层开关与参数
POSTGRES_AUTO_MIGRATE=true
POSTGRES_MIGRATIONS_PATH=migrations/postgres
SESSION_TTL_SECONDS=2592000
SESSION_MAX_HISTORY=500
SESSION_LOCAL_CACHE_SIZE=10000
SESSION_SLIDING_WINDOW_ROUNDS=5
REDIS_STREAM_MAXLEN=256
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 工具
TAVILY_API_KEY=
MCP_SERVER_URL=
